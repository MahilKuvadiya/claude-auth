{
  "name": "claudex-backend",
  "version": "0.1.0",
  "private": true,
  "description": "claudex pool backend — targeted join, token minting (sole refresher), telemetry ingest. Deployed as GCP Cloud Functions (gen2).",
  "type": "commonjs",
  "main": "index.js",
  "engines": { "node": ">=20" },
  "scripts": {
    "start": "functions-framework --target=poolJoin --port=8080",
    "start:token": "functions-framework --target=poolToken --port=8081",
    "start:telemetry": "functions-framework --target=telemetry --port=8082"
  },
  "dependencies": {
    "@google-cloud/functions-framework": "^3.4.0",
    "@google-cloud/firestore": "^7.9.0",
    "@google-cloud/secret-manager": "^5.6.0",
    "@google-cloud/pubsub": "^4.7.0",
    "firebase-admin": "^12.6.0",
    "jsonwebtoken": "^9.0.2"
  }
}
