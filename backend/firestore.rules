rules_version = '2';
// claudex Firestore rules.
// The backend (Cloud Functions with the claude-pool-backend SA) uses the Admin
// SDK and BYPASSES these rules — so all privileged writes go through it.
// These rules only gate the admin DASHBOARD (Firebase client SDK): admins may
// READ their org's data; nobody writes from the client; secrets never live here.
service cloud.firestore {
  match /databases/{db}/documents {

    function signedIn() { return request.auth != null; }
    function role() { return request.auth.token.role; }        // custom claim
    function isOrgAdmin(orgId) { return signedIn() && role() == 'org_admin' && request.auth.token.orgId == orgId; }
    function isPodLead()       { return signedIn() && role() == 'pod_lead'; }

    match /orgs/{orgId} {
      allow read: if isOrgAdmin(orgId);
      allow write: if false;                                    // backend only

      match /{document=**} {
        allow read: if isOrgAdmin(orgId);
        allow write: if false;
      }
    }

    // pools + members + rollups: readable by org admins / pod leads; never client-writable
    match /pools/{poolId} {
      allow read: if signedIn() && (role() == 'org_admin' || role() == 'pod_lead');
      allow write: if false;
      match /members/{memberId} {
        allow read: if signedIn() && (role() == 'org_admin' || role() == 'pod_lead');
        allow write: if false;
      }
      match /rollups/{period} {
        allow read: if signedIn() && (role() == 'org_admin' || role() == 'pod_lead');
        allow write: if false;
      }
    }

    // join links hold targeting info — never exposed to any client
    match /joinLinks/{token} {
      allow read, write: if false;
    }
  }
}
