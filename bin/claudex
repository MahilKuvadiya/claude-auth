#!/usr/bin/env python3
"""
claudex — switch between multiple Claude Code accounts on one machine.

Like `gh auth switch`, but for Claude Code. Snapshots the currently logged-in
account (Keychain credential blob + ~/.claude.json identity) into a named
profile, and restores any saved profile on demand.

macOS only (uses the login Keychain via the `security` CLI). Secret tokens stay
in the Keychain; only non-secret identity metadata is kept in a plaintext index.
"""

import sys
import os
import re
import json
import time
import shutil
import getpass
import signal
import base64
import hmac
import hashlib
import secrets
import threading
import subprocess
import argparse
import urllib.request
import urllib.error
import urllib.parse
import socket
import http.client
import ssl
import concurrent.futures
from http.server import ThreadingHTTPServer, BaseHTTPRequestHandler
from datetime import datetime, timezone

# When compiled with Nuitka, the bundled OpenSSL's default CA path points at the
# build machine (absent on the user's Mac) → HTTPS fails with "unable to get local
# issuer". macOS always ships a system CA bundle at /etc/ssl/cert.pem, so load it
# explicitly. Routing the default HTTPS-context factory through this covers every
# urllib request and http.client.HTTPSConnection in one place.
_MACOS_CA_BUNDLE = "/etc/ssl/cert.pem"

def _macos_ssl_context(*args, **kwargs):
    ctx = ssl.create_default_context(*args, **kwargs)
    try:
        if os.path.exists(_MACOS_CA_BUNDLE):
            ctx.load_verify_locations(_MACOS_CA_BUNDLE)
    except Exception:
        pass
    return ctx

ssl._create_default_https_context = _macos_ssl_context

