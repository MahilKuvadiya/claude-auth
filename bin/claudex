IND = "  "

def info(msg=""):
    print(msg)

def ok(msg):
    info(IND + green("✓") + " " + msg)

def warn(msg):
    info(IND + yellow("!") + " " + msg)

def step(msg):
    info(IND + clay("›") + " " + msg)

def hint(msg):
    info(IND + dim(msg))

def die(msg, code=1):
    print(IND + red("✗") + " " + msg, file=sys.stderr)
    sys.exit(code)

