{
  "name": "claudex-api",
  "version": "1.0.0",
  "private": true,
  "description": "claudex unified REST API (v1) — pool control-plane + data-plane. One Fastify service on Cloud Run.",
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "node --test test/unit/*.test.js test/contract.test.js",
    "test:integration": "node --experimental-test-module-mocks --test-concurrency=1 --test test/integration/*.test.js",
    "contract": "node --test test/contract.test.js",
    "lint": "node --check src/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:migrate:dev": "prisma migrate dev"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^12.0.1",
    "@fastify/rate-limit": "^10.1.1",
    "@google-cloud/firestore": "^8.6.0",
    "@google-cloud/pubsub": "^4.7.0",
    "@google-cloud/secret-manager": "^5.6.0",
    "@prisma/client": "^6.1.0",
    "@scalar/fastify-api-reference": "^1.25.0",
    "fastify": "^5.1.0",
    "firebase-admin": "^12.6.0",
    "jsonwebtoken": "^9.0.2",
    "yaml": "^2.6.0"
  },
  "devDependencies": {
    "pino-pretty": "^13.0.0",
    "prisma": "^6.1.0"
  }
}
