---
// Keep-warm: a session's prompt cache has a ~1h TTL. Every ~50 min the proxy replays
// the last request as a cheap cache-read, resetting the timer. viewBox 560×160, no clipping.
const caption = 'A cheap cache-read every ~50 min resets the 1-hour prompt-cache TTL — so returning stays ~0.1× cost.';
---
<figure class="mgfx">
  <svg viewBox="0 0 560 160" role="img" aria-label="Keep-warm cache TTL reset" style="width:100%;height:auto">
    <style>
      .track{fill:var(--sl-color-gray-5)}
      .fill{fill:var(--clay);animation:drain 4s ease-in-out infinite}
      @keyframes drain{0%{width:390px}68%{width:70px}70%{width:390px}100%{width:360px}}
      .t{fill:var(--sl-color-gray-3);font:600 11px ui-monospace,monospace}
      .ping{opacity:0;animation:ping 4s ease-in-out infinite}
      @keyframes ping{0%,64%{opacity:0}72%,86%{opacity:1}92%,100%{opacity:0}}
    </style>
    <text class="t" x="16" y="52">prompt cache TTL</text>
    <rect class="track" x="150" y="40" width="390" height="18" rx="9"></rect>
    <rect class="fill" x="150" y="40" height="18" rx="9"></rect>
    <g class="ping">
      <circle cx="150" cy="102" r="8" fill="var(--clay)"></circle>
      <text class="t" x="170" y="106" style="fill:var(--clay)">↺ replay last request → cache-read → TTL reset</text>
    </g>
    <text class="t" x="16" y="146">each warmed session stays on its own account · stops after 8h idle</text>
  </svg>
  <figcaption>{caption}</figcaption>
</figure>
