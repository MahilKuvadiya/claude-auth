# Copy to .env.local and fill in.
# GCP OAuth 2.0 Web Client id (APIs & Services → Credentials). Authorized JS origins must
# include your dashboard origin(s), e.g. http://localhost:5173 and the deployed URL.
VITE_GOOGLE_CLIENT_ID=
VITE_ALLOWED_DOMAIN=devxlabs.ai

# Unified REST API base.
# Local backend (dev-local.sh):  http://localhost:8080
# Prod:  https://claudex-api-prod-tvjj3mwixq-el.a.run.app
# UAT:   https://claudex-api-uat-tvjj3mwixq-el.a.run.app
VITE_API_URL=http://localhost:8080
